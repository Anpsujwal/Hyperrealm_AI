# Git
.git/
.gitignore

# Python caches, builds, and virtual environments
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
venv/
.venv/
backend/venv/
*.egg-info/

# Frontend dependencies and local build outputs (Docker builds its own dist in Stage 1)
node_modules/
frontend/node_modules/
frontend/dist/
.tmp/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment files & Secret Credentials (CRITICAL: Never bake secrets into Docker images)
.env
.env.local
.env.*.local
*.pem
*.key
hackathon-project-*.json
service-account*.json
credentials*.json
firebase-adminsdk*.json

# Local SQLite databases and uploaded media
backend/hyperrealm.db*
backend/uploads/
*.sqlite
*.sqlite3
*.db-shm
*.db-wal

# IDE, OS, and workspace artifacts
.vscode/
.idea/
.DS_Store
Thumbs.db
.gemini/
