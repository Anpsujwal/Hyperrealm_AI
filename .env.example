# HYPERREALM Environment Configuration
# Copy this file to .env and fill in real values.
# Never commit .env to version control.

# ── Frontend (Vite) ───────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000
VITE_FEATURE_VOICE_INPUT=false
VITE_FEATURE_REAL_AGENTS=false

# ── Backend — Application ─────────────────────────────────────────────────────
APP_NAME=HYPERREALM API
APP_VERSION=0.2.0
APP_ENV=development
DEBUG=true
HOST=0.0.0.0
PORT=8000

# ── Backend — CORS ────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (JSON array syntax)
# CORS_ORIGINS=["http://localhost:5173","http://localhost:4173"]

# ── Backend — Auth / JWT ──────────────────────────────────────────────────────
# CHANGE THIS in production — use a 256-bit random secret
JWT_SECRET=CHANGE_ME_IN_PRODUCTION_use_256_bit_random_value
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480

# ── Backend — Repository adapter ─────────────────────────────────────────────
# "sqlite"    → local SQLite database (backend/hyperrealm.db - persistent local storage)
# "memory"    → in-memory store (volatile, for quick tests)
# "firestore" → Google Firestore (requires FIREBASE_CREDENTIALS_PATH below)
REPOSITORY_BACKEND=sqlite
SQLITE_DB_PATH=backend/hyperrealm.db

# ── Google Cloud / Firebase (Phase 03+, optional for Phase 02) ───────────────
# GCP_PROJECT_ID=your-gcp-project-id
# GCP_REGION=us-central1
# FIREBASE_CREDENTIALS_PATH=/path/to/service-account.json
# VITE_GCP_PROJECT_ID=your-gcp-project-id
# VITE_GCP_REGION=us-central1

# ── Google ADK, Live Vertex AI & Gemini (Phase 04) ──────────────────────────
# "demo" → deterministic local execution, mocks, zero-credential tests
# "live" → live Gemini 2.5 on Vertex AI / Google ADK multi-agent runtime
APP_MODE=demo
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.0-flash

# Vertex AI Configuration:
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_APPLICATION_CREDENTIALS=

# Or Direct Gemini API Key (Alternative to Vertex AI service account):
GEMINI_API_KEY=

# Storage & Search:
VERTEX_AI_SEARCH_DATA_STORE_ID=
GCS_BUCKET_NAME=
